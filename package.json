{
  "name": "resume-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "reindex": "node --conditions=react-server --import tsx --env-file-if-exists=.env.local scripts/reindex.ts",
    "tracking": "node --conditions=react-server --import tsx --env-file-if-exists=.env.local scripts/tracking.ts",
    "qualification": "node scripts/verify-qualification.mjs qualification",
    "requalification": "node scripts/verify-qualification.mjs requalification",
    "continuation:qualification": "node scripts/verify-qualification.mjs continuation:qualification",
    "claim-repair:qualification": "node scripts/verify-qualification.mjs claim-repair:qualification",
    "omission-repair:qualification": "node --conditions=react-server --import tsx experiments/career-brain/v2/omission-repair/run.ts --stage=verify-preserved && node --conditions=react-server --import tsx experiments/career-brain/v2/omission-repair/report.ts && vitest run tests/career-omission-repair.test.ts tests/career-brain-continuity.test.ts tests/career-brain-serving.test.ts tests/career-brain-database.test.ts tests/career-brain-repository.test.ts tests/career-brain-live-artifacts.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
