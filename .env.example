# Development defaults to demo. Production requires an explicit demo or live mode.
APP_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_INGEST_MODEL=openai/gpt-6-luna-pro
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Resume Builder
# Cohere embeddings — server only. Dimension must match the pgvector migration.
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-v4.0
COHERE_EMBED_DIMENSION=1024
# Optional private owner area. Create this user in Supabase Auth; no public signup.
OWNER_USER_ID=
# Enable only after configuring the provider in Supabase Auth and callback allowlist.
AUTH_GOOGLE_ENABLED=false
AUTH_GITHUB_ENABLED=false
# Optional human-verification boundary. Configure BOTH values to enable challenges.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
AI_VISITOR_SPACING_SECONDS=5
AI_VISITOR_DAILY_LIMIT=25
AI_VISITOR_WEEKLY_LIMIT=50
# Service-only trial readiness, disabled; no public signup/purchase/redemption UI.
TRIAL_CREDIT_ENABLED=false
TRIAL_CREDIT_MICRO=
TRIAL_CREDIT_DAYS=30
